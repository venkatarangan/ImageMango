<Window x:Class="ImageMango.UI.PromptHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt helper" Width="760" Height="820" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="15" Icon="/Assets/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="440" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin sits on an inner panel so self-test pictures of the root line up. -->
    <Grid>
    <DockPanel Margin="16,12,16,14">
        <!-- Header: which image model the prompt is for, and which language model writes it -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="ForModel" Text="Prompt helper" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Improves your prompt or writes one from an idea, in the way the selected image model understands best. A small language model runs on this PC: nothing is sent anywhere and nothing is saved." />
            <DockPanel Margin="0,10,0,0">
                <TextBlock Text="Helper model" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock DockPanel.Dock="Right" x:Name="ModelState" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="NoWrap" />
                <ComboBox x:Name="ModelBox" SelectionChanged="ModelBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Blurb}" FontSize="13" Opacity="0.75" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <!-- One-time downloads -->
            <Border x:Name="SetupCard" Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="SetupText" TextWrapping="Wrap" />
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="DownloadButton" DockPanel.Dock="Left" Click="Download_Click" Padding="14,5" Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Download" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SetupProgress" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Status line and the main actions -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="14,5" Margin="8,0,0,0" />
            <Button x:Name="UseButton" DockPanel.Dock="Right" Click="Use_Click" Padding="14,5" Style="{DynamicResource AccentButtonStyle}" IsEnabled="False"
                    ToolTip="Put the suggestion in the prompt box (and the negative prompt, if there is one)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Use this prompt" />
                </StackPanel>
            </Button>
            <ProgressBar x:Name="Busy" DockPanel.Dock="Left" Width="60" Height="4" IsIndeterminate="True" Margin="0,0,10,0" Visibility="Hidden" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Hint}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <!-- What to do -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ImproveMode" Content="Improve my prompt" IsChecked="True" Margin="0,0,20,0" Checked="Mode_Checked" />
                    <RadioButton x:Name="IdeaMode" Content="Write a new prompt from an idea" Checked="Mode_Checked" />
                </StackPanel>
                <TextBlock x:Name="InputLabel" Text="Your prompt" FontWeight="SemiBold" Margin="0,10,0,4" />
                <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Any language is fine; the prompt comes back in English." />
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="SuggestButton" DockPanel.Dock="Right" Click="Suggest_Click" Padding="16,5" ToolTip="Ctrl+Enter">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="SuggestLabel" Text="Suggest" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" Padding="12,5" Margin="0,0,8,0" Visibility="Collapsed" />
                    <CheckBox x:Name="AskFirst" Content="Ask me questions when something important is unclear" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Questions from the helper -->
                <Border x:Name="QuestionsCard" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="A few questions first" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Text="Answer what matters to you; leave the rest empty and the helper chooses." Margin="0,2,0,6" />
                        <StackPanel x:Name="QuestionsPanel" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ContinueButton" Content="Write the prompt" Click="Continue_Click" Padding="14,5" Style="{DynamicResource AccentButtonStyle}" />
                            <Button x:Name="SkipButton" Content="Skip, you choose" Click="Skip_Click" Padding="12,5" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The suggestion -->
                <StackPanel x:Name="ResultPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="Suggested prompt (you can edit it)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="ResultPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="220" VerticalScrollBarVisibility="Auto" FontSize="16" />
                    <StackPanel x:Name="NegativeArea">
                        <TextBlock Text="Suggested negative prompt" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <TextBox x:Name="ResultNegative" TextWrapping="Wrap" MinHeight="52" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                    <TextBlock x:Name="ResultNotes" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Click="Again_Click" Padding="12,4" ToolTip="Ask for a different suggestion for the same request">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Try again" />
                            </StackPanel>
                        </Button>
                        <Button Click="Refine_Click" Padding="12,4" Margin="8,0,0,0"
                                ToolTip="Put the suggestion in the box above to improve it further or change it">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Improve this further" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Grid>
</Window>
