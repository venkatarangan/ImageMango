<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Mango icon for the exe, taskbar and title bar; regenerate with tools/make_icon.py. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Called LocalImageGen until 2026-10-16. -->
    <AssemblyName>ImageMango</AssemblyName>
    <AssemblyTitle>ImageMango</AssemblyTitle>
    <Product>ImageMango</Product>
    <Company>mangoidiots</Company>
    <Version>1.1.0</Version>
    <!-- Lets the project also compile on Linux/WSL for CI checks; running still needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Fluent ThemeMode is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="catalog\models.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\app.ico" />
    <!-- stable-diffusion.cpp + ggml + CUDA runtime DLLs, fetched by setup-engine.ps1 -->
    <None Include="..\..\engine\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="WarnMissingEngine" BeforeTargets="Build" Condition="!Exists('..\..\engine\stable-diffusion.dll')">
    <Warning Text="engine\stable-diffusion.dll not found. Run .\setup-engine.ps1 from the repository root before building, otherwise the app starts but cannot generate images." />
  </Target>

</Project>
